FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CMAKE_PREFIX_PATH=/opt/rocketmq

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl python3 cmake ninja-build build-essential pkg-config \
       libgrpc++-dev protobuf-compiler-grpc libprotobuf-dev libabsl-dev libssl-dev zlib1g-dev \
       libhiredis-dev librdkafka-dev default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/docker/fetch_rocketmq_cpp_sdk.py /tmp/fetch_rocketmq_cpp_sdk.py
RUN python3 /tmp/fetch_rocketmq_cpp_sdk.py \
    && sed -i 's/find_package(protobuf 3.19 CONFIG REQUIRED)/find_package(Protobuf 3.19 REQUIRED)/' /opt/rocketmq-source/cpp/CMakeLists.txt \
    && cmake -S /opt/rocketmq-source/cpp -B /tmp/rocketmq-sdk-build -G Ninja \
       -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF -DCMAKE_INSTALL_PREFIX=/opt/rocketmq \
    && cmake --build /tmp/rocketmq-sdk-build --parallel 4 \
    && cmake --install /tmp/rocketmq-sdk-build \
    && rm -rf /tmp/rocketmq-sdk-build /opt/rocketmq-source /tmp/fetch_rocketmq_cpp_sdk.py

WORKDIR /src
COPY . .
RUN cmake -S . -B /tmp/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_PREFIX_PATH=/opt/rocketmq -DENABLE_ROCKETMQ=ON \
    && cmake --build /tmp/build --target ecommerce_api_demo rocketmq_smoke_test --parallel 4

WORKDIR /app
RUN install -D /tmp/build/ecommerce_api_demo /app/ecommerce_api_demo
RUN install -D /tmp/build/rocketmq_smoke_test /app/rocketmq_smoke_test
COPY configs /app/configs
EXPOSE 8080
ENTRYPOINT ["/app/ecommerce_api_demo", "8080"]
